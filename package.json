{
  "name": "boldemort",
  "version": "0.1.4",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-only",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "eslint . --max-warnings 0 && stylelint src/*.css && html-validate index.html && markdownlint-cli2 README.md AGENTS.md PLAN.md DECISIONS.md CHANGELOG.md DEPENDENCIES.md",
    "format": "prettier --write index.html \"src/**/*\" \"tests/**/*\" \"scripts/*.mjs\" \"*.json\" \"*.config.*\"",
    "format:check": "prettier --check index.html \"src/**/*\" \"tests/**/*\" \"scripts/*.mjs\" \"*.json\" \"*.config.*\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "dependencies:check": "node scripts/dependencies.mjs --check",
    "coverage:browser": "vite build --mode coverage && BOLD_COVERAGE=1 playwright test --project=chromium && node scripts/coverage.mjs",
    "mutation": "stryker run"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "mdast-util-from-markdown": "2.1.0",
    "mdast-util-gfm": "3.1.0",
    "micromark-extension-gfm": "3.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.1",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "html-validate": "11.21.1",
    "istanbul-lib-coverage": "3.2.2",
    "istanbul-lib-source-maps": "5.0.6",
    "markdownlint-cli2": "0.24.1",
    "prettier": "3.10.1",
    "stylelint": "18.0.0",
    "stylelint-config-standard": "41.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vite-plugin-istanbul": "9.0.1",
    "vitest": "5.1.1"
  },
  "overrides": {
    "test-exclude": {
      "glob": "14.0.6"
    },
    "typed-rest-client": {
      "qs": "6.17.1"
    },
    "minimatch": "11.0.9"
  }
}

{
  "name": "boldemort",
  "version": "0.4.7",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "dev": "vite --config config/vite.config.ts --host 127.0.0.1",
    "build": "vite build --config config/vite.config.ts",
    "preview": "vite preview --config config/vite.config.ts --host 127.0.0.1",
    "lint": "eslint --config config/eslint.config.mjs . --max-warnings 0 && stylelint --config config/stylelint.config.mjs src/*.css && html-validate --config config/htmlvalidate.json index.html && markdownlint-cli2 README.md AGENTS.md vision.md \"docs/*.md\"",
    "format": "prettier --config config/prettier.json --write index.html package.json \"src/**/*\" \"tests/**/*\" \"scripts/*.mjs\" \"config/**/*\" \".github/workflows/*.yml\"",
    "format:check": "prettier --config config/prettier.json --check index.html package.json \"src/**/*\" \"tests/**/*\" \"scripts/*.mjs\" \"config/**/*\" \".github/workflows/*.yml\"",
    "typecheck": "tsc --project config/tsconfig.json --noEmit",
    "test": "vitest run --config config/vitest.config.ts",
    "coverage": "vitest run --config config/vitest.config.ts --coverage",
    "performance": "node scripts/performance.mjs",
    "e2e": "playwright test --config config/playwright.config.ts",
    "dependencies:check": "node scripts/dependencies.mjs --check",
    "coverage:browser": "vite build --config config/vite.config.ts --mode coverage && BOLD_COVERAGE=1 npm run e2e -- --project=chromium && node scripts/coverage.mjs",
    "mutation": "stryker run config/stryker.config.json"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "mdast-util-from-markdown": "2.1.0",
    "mdast-util-gfm": "3.1.0",
    "micromark-extension-gfm": "3.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@types/node": "26.6.10",
    "@vitest/coverage-v8": "5.1.2",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "html-validate": "11.22.1",
    "istanbul-lib-coverage": "3.2.2",
    "istanbul-lib-source-maps": "5.0.6",
    "markdownlint-cli2": "0.24.2",
    "prettier": "3.10.1",
    "stylelint": "18.1.0",
    "stylelint-config-standard": "41.1.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vite": "8.3.8",
    "vite-plugin-istanbul": "9.0.1",
    "vitest": "5.1.2"
  },
  "overrides": {
    "test-exclude": {
      "glob": "14.0.6"
    },
    "typed-rest-client": {
      "qs": "6.17.1"
    },
    "minimatch": "11.0.9",
    "micromark-extension-math": {
      "katex": "0.19.1"
    }
  }
}
